<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>QuotaLens</AssemblyName>
    <RootNamespace>QuotaLens.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets/AppIcon.ico')">Assets/AppIcon.ico</ApplicationIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="../QuotaLens.Infrastructure/QuotaLens.Infrastructure.csproj" />
    <!-- The executable icon is a Win32 resource. Keep its loose tray copy out
         of the PRI content item graph so it cannot be registered twice. -->
    <None Remove="Assets/AppIcon.ico" />
    <Content Remove="Assets/AppIcon.ico" />
  </ItemGroup>
  <!-- Ship this build's compiled app/runtime resources with the unpackaged app. -->
  <Target Name="PublishQuotaLensXamlResources" AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <QuotaLensXamlResource Include="$(OutputPath)**\*.xbf" />
      <QuotaLensXamlResource Include="$(OutputPath)**\*.pri" />
    </ItemGroup>
    <Error Condition="'@(QuotaLensXamlResource)' == ''" Text="No compiled WinUI resources were generated; refusing an incomplete publish." />
    <Copy SourceFiles="@(QuotaLensXamlResource)"
          DestinationFiles="@(QuotaLensXamlResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Assets/AppIcon.ico"
          DestinationFolder="$(PublishDir)Assets"
          Condition="Exists('$(MSBuildProjectDirectory)/Assets/AppIcon.ico')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
