<Application x:Class="QuotaLens.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="CanvasBrush" Color="#F6F9FC" />
     <SolidColorBrush x:Key="SidebarBrush" Color="#EAF1F7" />
     <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
     <SolidColorBrush x:Key="LineBrush" Color="#DEE7F0" />
     <SolidColorBrush x:Key="TextBrush" Color="#19283B" />
     <SolidColorBrush x:Key="MutedBrush" Color="#6F829A" />
     <SolidColorBrush x:Key="AccentBrush" Color="#078EA4" />
     <SolidColorBrush x:Key="SelectionBrush" Color="#E0F3F7" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="CanvasBrush" Color="#101925" />
     <SolidColorBrush x:Key="SidebarBrush" Color="#14202D" />
     <SolidColorBrush x:Key="CardBrush" Color="#192637" />
     <SolidColorBrush x:Key="LineBrush" Color="#2B3B50" />
     <SolidColorBrush x:Key="TextBrush" Color="#E8EFF7" />
     <SolidColorBrush x:Key="MutedBrush" Color="#9AAEC5" />
     <SolidColorBrush x:Key="AccentBrush" Color="#3ABED1" />
     <SolidColorBrush x:Key="SelectionBrush" Color="#1B3948" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="SidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="LineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="TextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
     <SolidColorBrush x:Key="SelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12,8" /></Style>
   <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text" /><Setter Property="Foreground" Value="{ThemeResource TextBrush}" /></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
