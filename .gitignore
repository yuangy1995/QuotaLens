# Whitelist-only repository: keep source, resources, scripts, and docs.
*

!/.gitignore
!/LICENSE
!/README.md
!/README.zh-CN.md
!/CHANGELOG.md
!/VERSION
!/Package.swift
!/Package.resolved

!/.github/
!/.github/workflows/
!/.github/workflows/release.yml

!/docs/
!/docs/releasing.md
!/docs/review-2026-08-26.md

!/Sources/
!/Sources/**

!/Resources/
!/Resources/Info.plist
!/Resources/AppIcon.icns

!/scripts/
!/scripts/*.sh

!/Tests/
!/Tests/**
