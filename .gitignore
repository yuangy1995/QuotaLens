# Keep source, intentional resources, scripts and documentation only.
*
!/.gitignore
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/README.md
!/README.zh-CN.md
!/CHANGELOG.md
!/VERSION
!/Package.swift
!/Package.resolved
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/docs/
!/docs/*.md
!/Sources/
!/Sources/**
!/Resources/
!/Resources/Info.plist
!/Resources/AppIcon.icns
!/scripts/
!/scripts/*.sh
!/Tests/
!/Tests/**
!/shared/
!/shared/**/
!/shared/fixtures/*.json
!/windows/
!/windows/**/
!/windows/**/*.cs
!/windows/**/*.csproj
!/windows/**/*.props
!/windows/**/*.targets
!/windows/**/*.xaml
!/windows/**/*.manifest
!/windows/**/*.ps1
!/windows/**/*.py
!/windows/**/*.md
!/windows/global.json
!/windows/**/packages.lock.json
# Build output and machine/private material must never be committed.
/windows/**/bin/
/windows/**/obj/
/windows/**/.vs/
/windows/**/__pycache__/
/windows/artifacts/
/windows/validation/
/windows/QuotaLens.Windows/Assets/AppIcon.ico
**/*.user
**/*.suo
**/*.sqlite*
**/*.qcred
**/master.key
**/auth.json
**/.credentials.json
**/.env
**/*.pfx
**/*.p12
